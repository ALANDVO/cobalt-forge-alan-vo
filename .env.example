# Cobalt Forge Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=cobalt-forge
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./cobalt_forge.db

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Keycloak / OIDC
OIDC_ISSUER_URL=http://localhost:8080/realms/cobalt-forge
OIDC_CLIENT_ID=cobalt-forge
OIDC_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION
OIDC_REDIRECT_URI=http://localhost:3000/callback
OIDC_SCOPES=openid profile email

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# LLM (Optional - for AI-assisted features)
# LLM_API_KEY=your-api-key-here
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=gpt-4
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_SECONDS=30